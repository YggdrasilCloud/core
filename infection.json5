{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Photo/Infrastructure/Persistence/Doctrine/Entity",
            "Shared/Infrastructure/Doctrine/DQL",
            // File Storage infrastructure - tests pending (DSN parsing, factory, adapters)
            "File/Infrastructure/Storage",
            // FileResponder is tested via functional tests, not unit tests
            // Contains streaming logic that cannot be effectively unit tested
            "Photo/UserInterface/Http/Responder/FileResponder.php"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "tmpDir": "var/cache/infection",
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    },
    "testFramework": "phpunit",
    // Current MSI on PHP 8.4: ~93%
    // Increased from 76% after removing @coversNothing annotations
    "minMsi": 90,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true,
        "@function_signature": false
    },
    "bootstrap": "tests/bootstrap.php"
}
